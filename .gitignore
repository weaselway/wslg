.vscode/*
vendor/*
!vendor/.preserve
out
tmp

# Generated build trees. The meson ones each drop their own .gitignore with
# a '*' in it, but build/wsl-kernel is a git clone and would otherwise show up
# as an untracked nested repo.
build/
*.nupkg
*.tar
*.vhd
WSLGd/*.d
WSLGd/*.o
WSLGd/WSLGd
WSLDVCPlugin/.vs
WSLDVCPlugin/x64
WSLDVCPlugin/ARM64/Debug/
WSLDVCPlugin/ARM64/Release/
WSLDVCPlugin/WSLDVCPlugin.aps
